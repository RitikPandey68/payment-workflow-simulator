# Application Settings
APP_NAME=Payment Workflow Simulator
APP_VERSION=1.0.0
DEBUG=true

# Database — update with your PostgreSQL credentials
DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
WEBHOOK_SECRET=whsec_payment_simulator_secret_key_2024

# Payment Simulation Settings
PAYMENT_FAILURE_RATE=0.15
WEBHOOK_DELIVERY_FAILURE_RATE=0.20
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=1.0

# Webhook Endpoint (where gateway delivers webhooks)
WEBHOOK_ENDPOINT_URL=http://localhost:8000/api/v1/webhooks/receive

# CORS
ALLOWED_ORIGINS=["*"]
